{
  "name": "starcore",
  "private": true,
  "license": "MIT",
  "version": "1.16.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src vite.config.ts vitest.config.ts --fix",
    "lint:check": "eslint src vite.config.ts vitest.config.ts",
    "check:conservation": "node scripts/check-conservation.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check": "corepack pnpm build && corepack pnpm test && corepack pnpm check:conservation && corepack pnpm check:locales --strict && corepack pnpm lint:check && corepack pnpm format:check"
  },
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "decimal.js": "^10.6.0",
    "localforage": "^1.10.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.3.11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.9",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23"
    }
  }
}
