{
  "name": "starcore",
  "private": true,
  "license": "MIT",
  "version": "1.71.0",
  "type": "module",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "lint": "eslint src vite.config.ts vitest.config.ts --fix",
    "lint:check": "eslint src vite.config.ts vitest.config.ts",
    "check:conservation": "node scripts/check-conservation.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "check:size": "node scripts/check-size.mjs",
    "check:docs": "node tools/check-docs.mjs --strict",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "check": "corepack pnpm build && corepack pnpm test:cov && corepack pnpm check:conservation && corepack pnpm check:locales --strict && corepack pnpm check:size && corepack pnpm lint:check && corepack pnpm format:check && corepack pnpm check:docs",
    "diagnose": "node tools/diagnose.mjs",
    "e2e": "node tools/e2e/run.mjs"
  },
  "dependencies": {
    "@vue/devtools-api": "8.2.1",
    "decimal.js": "^10.6.0",
    "localforage": "^1.10.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.4",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "playwright-core": "^1.64.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion": ">=5.0.12",
      "nanoid": ">=3.3.18",
      "postcss": ">=8.5.23",
      "source-map-js": ">=1.2.2",
      "postcss-selector-parser": ">=7.1.6"
    }
  }
}
